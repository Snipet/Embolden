{
  "manifest_version": 3,
  "name": "Embolden – Reading Focus",
  "description": "Bolds the first letters of every word, giving your eyes fixation anchors that make reading easier — built with ADHD in mind.",
  "version": "0.2.0",
  "minimum_chrome_version": "100",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/core.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": { "default_popup": "popup/popup.html" },
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Alt+B" },
      "description": "Toggle Embolden on this site"
    }
  }
}
